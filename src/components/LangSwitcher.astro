---
import { languages, type Lang } from '../i18n/ui';
import { localizePath, stripLang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const basePath = stripLang(Astro.url.pathname);
---
<div class="lang-switcher" role="group" aria-label="Language">
  {Object.entries(languages).map(([code, label]) => (
    <a
      href={localizePath(basePath, code as Lang)}
      hreflang={code}
      lang={code}
      title={label}
      aria-current={code === lang ? 'true' : undefined}
    >{code.toUpperCase()}</a>
  ))}
</div>

<style>
  .lang-switcher { display: inline-flex; border: 1px solid var(--border); border-radius: 999px; padding: 2px; }
  a { padding: 4px 10px; border-radius: 999px; font-size: .8rem; font-weight: 600; color: var(--muted); }
  a[aria-current] { background: var(--accent); color: var(--on-accent); }
</style>
