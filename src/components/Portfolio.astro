---
import Base from '../layouts/Base.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { tr, type Lang } from '../i18n/ui';
import { useTranslations, localizePath, formatDate, monthsBetween } from '../i18n/utils';
import { profile, experience, projects, skills } from '../data/cv';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const jobs = experience.filter((j) => j.portfolio !== false);
const works = projects.filter((p) => p.portfolio !== false);
const year = new Date().getFullYear();
---
<Base lang={lang}>
  <header class="site-header">
    <a class="logo" href={localizePath('/', lang)}>{profile.shortName}</a>
    <nav aria-label="Main">
      <a href="#about">{t('nav.about')}</a>
      <a href="#experience">{t('nav.experience')}</a>
      <a href="#projects">{t('nav.projects')}</a>
      <a href="#contact">{t('nav.contact')}</a>
      <a href={localizePath('/cv', lang)}>{t('nav.cv')}</a>
    </nav>
    <div class="header-tools">
      <LangSwitcher lang={lang} />
      <ThemeToggle label={t('theme.toggle')} />
    </div>
  </header>

  <main>
    <section class="hero container" id="about">
      <Image class="photo" src={profile.photo} alt={t('meta.photoAlt')} width={280} height={280} densities={[1, 2]} loading="eager" fetchpriority="high" />
      <div>
        <p class="eyebrow">{tr(profile.role, lang)}</p>
        <h1>{profile.name}</h1>
        <p class="lead">{tr(profile.heroText, lang)}</p>
        <ul class="chips">
          {skills.flatMap((g) => g.items).slice(0, 10).map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <section class="container" id="experience">
      <h2>{t('section.experience')}</h2>
      <ol class="timeline">
        {jobs.map((job) => (
          <li class="card">
            <div class="card-head">
              <h3>{job.company}</h3>
              <span class="muted">
                {`${formatDate(job.start, lang)} – ${job.end ? formatDate(job.end, lang) : t('job.present')} · ${monthsBetween(job.start, job.end)} ${t('job.months')}`}
              </span>
            </div>
            <p class="role">{tr(job.role, lang)}</p>
            <p>{tr(job.description, lang)}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container" id="projects">
      <h2>{t('section.projects')}</h2>
      <div class="grid">
        {works.map((p) => (
          <article class="card project">
            {p.image && (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="thumb">
                <Image src={p.image} alt={p.imageAlt ? tr(p.imageAlt, lang) : ''} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
              </a>
            )}
            <h3>{tr(p.title, lang)}</h3>
            <p>{tr(p.description, lang)}</p>
            <ul class="chips small">{p.tech.map((x) => <li>{x}</li>)}</ul>
            {p.url && (
              <a class="link" href={p.url} target="_blank" rel="noopener noreferrer">
                {t('project.visit')} <Icon name="external" size={14} />
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer" id="contact">
    <div class="container footer-grid">
      <div>
        <h2>{t('contact.title')}</h2>
        <p>{t('contact.text')}</p>
        <div class="buttons">
          <a class="btn" href={`mailto:${profile.email}?subject=Portfolio`}><Icon name="mail" /> {t('contact.cta')}</a>
          <a class="btn ghost" href={localizePath('/cv', lang)}>{t('contact.cv')}</a>
        </div>
      </div>
      <div>
        <h2>{t('footer.socials')}</h2>
        <ul class="socials">
          {profile.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener"><Icon name={l.icon ?? 'web'} /> {l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <p class="credits">© {year} {profile.name}. {t('footer.rights')}</p>
  </footer>
</Base>

<style>
  .site-header {
    position: sticky; top: 12px; z-index: 10; margin: 12px auto 0; width: min(1000px, calc(100% - 32px));
    display: flex; align-items: center; gap: 1rem; padding: 10px 16px; border-radius: 14px;
    background: color-mix(in srgb, var(--bg) 75%, transparent); backdrop-filter: blur(10px);
    border: 1px solid var(--border);
  }
  .logo { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; color: var(--text); }
  nav { display: flex; gap: 1.2rem; margin-inline: auto; }
  nav a { color: var(--muted); font-weight: 500; font-size: .95rem; }
  nav a:hover { color: var(--accent); }
  .header-tools { display: flex; gap: .5rem; align-items: center; }

  .hero { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: center; min-height: 60vh; padding-top: 3rem; }
  .photo { width: 280px; height: 280px; object-fit: cover; border-radius: 24px; border: 1px solid var(--border); }
  .eyebrow { color: var(--accent); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-size: .85rem; margin: 0; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: .2em 0 .4em; line-height: 1.05; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 60ch; }

  section + section { margin-top: 5rem; }
  .timeline { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .card-head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: baseline; }
  .card h3 { margin: 0; }
  .role { color: var(--accent); font-weight: 600; margin: .2rem 0 .6rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .project { display: flex; flex-direction: column; gap: .6rem; }
  .project h3 { margin-top: .2rem; }
  .project p { margin: 0; color: var(--muted); }
  .thumb img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 10px; border: 1px solid var(--border); }
  .link { margin-top: auto; display: inline-flex; gap: .35rem; align-items: center; font-weight: 600; }

  .site-footer { margin-top: 6rem; padding: 3rem 0 1.5rem; background: var(--surface); border-top: 1px solid var(--border); }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; }
  .footer-grid h2 { font-size: 1.4rem; }
  .buttons { display: flex; gap: .75rem; flex-wrap: wrap; }
  .socials { list-style: none; padding: 0; display: grid; gap: .6rem; }
  .socials a { display: inline-flex; gap: .5rem; align-items: center; color: var(--text); }
  .socials a:hover { color: var(--accent); }
  .credits { text-align: center; color: var(--muted); font-size: .85rem; margin-top: 3rem; }

  @media (max-width: 760px) {
    nav { display: none; }
    .header-tools { margin-left: auto; }
    .hero { grid-template-columns: 1fr; text-align: center; padding-top: 2rem; min-height: auto; }
    .photo { margin: 0 auto; width: 200px; height: 200px; }
    .lead { margin-inline: auto; }
    .chips { justify-content: center; }
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
